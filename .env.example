# Variables públicas para el navegador (RLS debe permanecer activado).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Variables exclusivas del servidor: nunca usar prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Solo para responder desde el CRM. Recibir no la usa: los mensajes entrantes
# los empuja Zernio y se validan con ZERNIO_WEBHOOK_SECRET.
ZERNIO_API_KEY=YOUR_ZERNIO_API_KEY
# Opcional: el valor por defecto ya es el correcto.
ZERNIO_API_BASE_URL=https://zernio.com/api
ZERNIO_WEBHOOK_SECRET=replace-with-a-long-random-secret

# YCloud (WhatsApp oficial). Mismo reparto que Zernio: el secreto valida lo que
# entra, la key autentica lo que sale.
YCLOUD_API_KEY=YOUR_YCLOUD_API_KEY
YCLOUD_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Opcional: el valor por defecto ya es el correcto.
YCLOUD_API_BASE_URL=https://api.ycloud.com/v2

# Protege el cron de los avisos de tareas (/api/cron/tareas): sin este valor
# no contesta. Cualquier cadena larga y al azar sirve.
CRON_SECRET=

# Citas de Google Calendar. El CRM no habla con Google: n8n avisa del alta, del
# cambio y de la baja de cada evento, y este secreto es lo que autentica ese
# aviso. En n8n va como credencial, no pegado en el nodo. Cualquier cadena larga
# y al azar sirve.
CALENDAR_WEBHOOK_SECRET=

# Para que los agentes respondan solos. El webhook corre sin navegador, así que
# no puede usar la key que cada usuario guarda en Configuración.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Web Push para avisar derivaciones aun con el CRM cerrado. El par se genera
# una sola vez con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
# Contacto técnico del emisor. Tiene que ser una URL https o un mailto válido.
VAPID_SUBJECT=mailto:admin@your-domain.com
